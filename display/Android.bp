            ],
        },
        {
            version: "16",
            imports: [
                "android.hardware.graphics.common-V7",
                "android.hardware.common-V2",
            ],
        },
        {
            version: "17",
            imports: [
                "android.hardware.graphics.common-V7",
                "android.hardware.common-V2",
            ],
        },

    ],
    frozen: true,

}

//   Current version of the com.google.hardware.pixel.display AIDL interface.
//   Please update the version when creating a new HAL AIDL to provide the new AIDL
//   to dependent modules (e.g. HWC).
latest_idisplay_version = "//hardware/google/interfaces:com.google.hardware.pixel.display-V17"

cc_defaults {
    name: "com.google.hardware.pixel.display-ndk_shared",
    shared_libs: [
        latest_idisplay_version + "-ndk",
    ],
}

java_defaults {
    name: "com.google.hardware.pixel.display-java_shared",
    static_libs: [
        latest_idisplay_version + "-java",
    ],
}
