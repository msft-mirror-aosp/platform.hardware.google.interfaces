aidl_interface {
    name: "pixel-power-ext",
    owner: "google",
    vendor_available: true,
    srcs: [
        "google/hardware/power/extension/pixel/*.aidl",
    ],

    stability: "vintf",

    backend: {
        java: {
            platform_apis: true,
        },
    },

    frozen: false,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}
